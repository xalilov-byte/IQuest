{
  "appId": "uz.iquest.app",
  "appName": "IQuest",
  "webDir": "www",
  "android": {
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#14121F",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#14121F"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_iquest",
      "iconColor": "#FF5B3A"
    }
  }
}
